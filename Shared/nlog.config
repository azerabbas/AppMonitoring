<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xsi:schemaLocation="NLog NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogFile="c:\temp\console-example-internal.log"
      internalLogLevel="Info">

	<targets>
		<target
          xsi:type="Database"
          name="database"
          keepConnection="true"
          dbProvider="System.Data.SqlClient"
          commandType="CommandType.Text">
			<connectionString>
				Server=(Local); DataBase=TraceabilityDB; User Id=sa; Password=asdfghjkl; Encrypt=False
			</connectionString>
			<commandText>
				INSERT INTO TraceabilityLogs
				(EventDateTime, EventLevel, CorrelationId, MachineName, EventMessage, ErrorSource, ErrorClass, ErrorMethod, ErrorMessage, InnerErrorMessage)
				VALUES
				(@EventDateTime, @EventLevel, @CorrelationId, @MachineName, @EventMessage, @ErrorSource, @ErrorClass, @ErrorMethod, @ErrorMessage, @InnerErrorMessage)
			</commandText>

			<parameter name="@EventDateTime" layout="${date:s}" />
			<parameter name="@EventLevel" layout="${level}" />
			<parameter name="@CorrelationId" layout="${activityid}"/>
			<parameter name="@MachineName" layout="${machinename}" />
			<parameter name="@EventMessage" layout="${message}" />
			<parameter name="@ErrorSource" layout="${event-context:item=error-source}" />
			<parameter name="@ErrorClass" layout="${event-context:item=error-class}" />
			<parameter name="@ErrorMethod" layout="${event-context:item=error-method}" />
			<parameter name="@ErrorMessage" layout="${event-context:item=error-message}" />
			<parameter name="@InnerErrorMessage" layout="${event-context:item=inner-error-message}" />
		</target>
	</targets>

	<rules>
		<logger name="*" minlevel="Debug" writeTo="database" />
	</rules>
</nlog>